[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/controls_menu.gd" id="1_controls"]

[node name="ControlsMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_controls")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 1)

[node name="Menu" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -240.0
offset_top = -300.0
offset_right = 240.0
offset_bottom = 300.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12
alignment = 1

[node name="Title" type="Label" parent="Menu"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "COMANDI"
horizontal_alignment = 1

[node name="Hint" type="Label" parent="Menu"]
layout_mode = 2
theme_override_colors/font_color = Color(0.66, 0.71, 0.8, 1)
theme_override_font_sizes/font_size = 14
text = "Clicca un comando e premi un tasto A-Z o 0-9"
horizontal_alignment = 1

[node name="Rows" type="VBoxContainer" parent="Menu"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="Message" type="Label" parent="Menu"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.62, 0.3, 1)
theme_override_font_sizes/font_size = 14
horizontal_alignment = 1

[node name="BackButton" type="Button" parent="Menu"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "Indietro"

[connection signal="pressed" from="Menu/BackButton" to="." method="_on_back_button_pressed"]
