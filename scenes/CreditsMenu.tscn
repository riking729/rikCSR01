[node name="Scroll" type="ScrollContainer" parent="Content"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
vertical_scroll_mode = 1

[node name="Entries" type="VBoxContainer" parent="Content/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="Note" type="Label" parent="Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.59, 0.66, 1)
theme_override_font_sizes/font_size = 12
text = "I modelli delle auto sono generici e privi di marchi. I nomi citati appartengono ai rispettivi proprietari.
I file di licenza completi sono inclusi nella cartella del gioco."
horizontal_alignment = 1
autowrap_mode = 3

[node name="BackButton" type="Button" parent="Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "Indietro"

[connection signal="pressed" from="Content/BackButton" to="." method="_on_back_button_pressed"]
