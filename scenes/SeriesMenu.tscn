[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/series_menu.gd" id="1_series"]

[node name="SeriesMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_series")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 1)

[node name="Menu" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -440.0
offset_top = -330.0
offset_right = 440.0
offset_bottom = 330.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 14
alignment = 1

[node name="Title" type="Label" parent="Menu"]
layout_mode = 2
theme_override_font_sizes/font_size = 34
text = "SERIE DI GARE"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Menu"]
layout_mode = 2
theme_override_colors/font_color = Color(0.66, 0.71, 0.8, 1)
theme_override_font_sizes/font_size = 14
text = "Vinci per passare alla gara successiva. Se perdi, ripeti la stessa gara.
La difficoltà IA cresce gara dopo gara."
horizontal_alignment = 1

[node name="SeriesButtons" type="GridContainer" parent="Menu"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 10
columns = 3

[node name="SeriesInfo" type="Label" parent="Menu"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.78, 0.3, 1)
theme_override_font_sizes/font_size = 16
horizontal_alignment = 1

[node name="Races" type="VBoxContainer" parent="Menu"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="StartButton" type="Button" parent="Menu"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
text = "Avvia gara"

[node name="BackButton" type="Button" parent="Menu"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Indietro"

[connection signal="pressed" from="Menu/StartButton" to="." method="_on_start_button_pressed"]
[connection signal="pressed" from="Menu/BackButton" to="." method="_on_back_button_pressed"]
